# Optional login hint. Password and SMS code are entered interactively, never stored here.
MESH_LOGIN=
MESH_AUTH_FILE=.secrets/auth.json
MESH_REGISTRATION_FILE=.secrets/registration.json
# Parent profile ID, NOT the child's ID. Leave empty for automatic discovery.
MESH_PROFILE_ID=
# Optional child selection for diagnostic CLI commands; the bot discovers all children.
MESH_STUDENT_ID=
MESH_HTTP_TIMEOUT=20
# Optional trusted CA bundle; TLS verification always remains enabled.
MESH_CA_BUNDLE=
# Optional HTTP/SOCKS proxy reachable from this machine.
MESH_PROXY=
TZ=Europe/Moscow

# false enables Telegram and requires both settings below.
WORKER_ONLY=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional shared channel/group ID (negative). Can also be connected through the bot.
TELEGRAM_REPORT_CHAT_ID=
# Optional HTTP/SOCKS5 proxy when this server cannot reach api.telegram.org.
TELEGRAM_PROXY=
DATABASE_PATH=data/bot.db
DAILY_REPORT_TIME=19:00
SEND_EMPTY_DAILY_REPORT=false
# Estimated fives needed: school-specific target mean and weight of each future five.
FINAL_FIVE_THRESHOLD=4.50
FINAL_FIVE_WEIGHT=1
